{{- $cluster := env "DEMO_CLUSTER_NAME" | default "artemis-demo" -}}
{{- $namespace := env "DEMO_NAMESPACE" | default "artemis-demo" -}}
# Generated by artemis {{ .Version }} from commit {{ .GitCommit | default "unknown" }}.
version = 1

[install]
kind.pkg-path    = "kind"
kubectl.pkg-path = "kubectl"

[vars]
DEMO_CLUSTER_NAME = "{{ $cluster }}"
DEMO_NAMESPACE    = "{{ $namespace }}"

[hook]
on-activate = '''
  # Keep cluster credentials inside the project instead of ~/.kube/config.
  export KUBECONFIG="$FLOX_ENV_PROJECT/.kube/config"

  if [ "${DEMO_SKIP_CLUSTER:-0}" = "1" ]; then
    echo "DEMO_SKIP_CLUSTER=1: not creating the kind cluster." >&2
  elif ! { docker info >/dev/null 2>&1 || podman info >/dev/null 2>&1; }; then
    # kind needs a running container engine, which flox cannot provide.
    echo "No running Docker or Podman found; skipping kind cluster creation." >&2
    echo "Start one, then exit and re-run: flox activate" >&2
  elif ! kind get clusters 2>/dev/null | grep -qx "$DEMO_CLUSTER_NAME"; then
    echo "Creating kind cluster '$DEMO_CLUSTER_NAME'..." >&2
    kind create cluster \
      --name "$DEMO_CLUSTER_NAME" \
      --config "$FLOX_ENV_PROJECT/kind-config.yaml" >&2
  else
    # Cluster exists; refresh credentials in case .kube/ was deleted.
    kind export kubeconfig --name "$DEMO_CLUSTER_NAME" >/dev/null 2>&1
  fi
'''

[profile]
common = '''
  alias k=kubectl
'''

[options]
systems = ["aarch64-darwin", "x86_64-darwin", "aarch64-linux", "x86_64-linux"]
